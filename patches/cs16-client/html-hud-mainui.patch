+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+
+// Tells the web page (Module.hudEvent, see cl_dll/web_bridge.h) when the menu
+// opens or closes, so it can hide its HTML HUD. EM_JS parameter lists must
+// not be padded: the loader takes the last word as the argument name.
+EM_JS( void, js_menu_visible, (int visible), {
+	var f = Module["hudEvent"];
+	if( typeof f !== "function" ) return;
+	try { f( "menu", { visible: !!visible } ); } catch( e ) { console.error( "hudEvent", e ); }
+} );
+#else
+static void js_menu_visible( int ) { }
+#endif
+
+static void UI_WebMenuState( void )
+{
+	static int lastVisible = -1;
+	int visible = uiStatic.menu.IsActive() ? 1 : 0;
+
+	if( visible == lastVisible )
+		return;
+
+	lastVisible = visible;
+	js_menu_visible( visible );
+}
+
 cvar_t		*ui_showmodels;
 cvar_t		*ui_show_window_stack;
