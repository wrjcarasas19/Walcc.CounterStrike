diff --git a/engine/server/sv_client.c b/engine/server/sv_client.c
index 089e61e..50c2f99 100644
--- a/engine/server/sv_client.c
+++ b/engine/server/sv_client.c
@@ -1061,14 +1061,24 @@ void SV_RemoteCommand( netadr_t from, sizebuf_t *msg )
 {
 	const char	*adr;
 	int		i;
+	qboolean	quiet;
 
 	if( !rcon_enable.value || !COM_CheckStringEmpty( rcon_password.string ))
 		return;
 
 	adr = NET_AdrToString( from );
 
-	Con_Printf( "Rcon from %s:\n%s\n", adr, MSG_GetData( msg ) + 4 );
-	Log_Printf( "Rcon: \"%s\" from \"%s\"\n", MSG_GetData( msg ) + 4, adr );
+	// The web server's own console (consoleAddr in src/server/console.go)
+	// sends its commands from 254.0.0.1, several times a second while
+	// anyone is in voice chat, and logs what it runs itself. Its commands
+	// and their output only go back to it: nothing on the server's console
+	// or in its log (where the password would be, too).
+	quiet = !Q_strncmp( adr, "254.0.0.1:", 10 );
+	if( !quiet )
+	{
+		Con_Printf( "Rcon from %s:\n%s\n", adr, MSG_GetData( msg ) + 4 );
+		Log_Printf( "Rcon: \"%s\" from \"%s\"\n", MSG_GetData( msg ) + 4, adr );
+	}
 
 	if( Rcon_Validate( ))
 	{
@@ -1085,8 +1095,10 @@ void SV_RemoteCommand( netadr_t from, sizebuf_t *msg )
 		}
 
 		SV_BeginRedirect( &host.rd, from, RD_PACKET, outputbuf, sizeof( outputbuf ) - 16, SV_FlushRedirect );
+		host.rd.quiet = quiet;
 		Cmd_ExecuteString( remaining );
 		SV_EndRedirect( &host.rd );
+		host.rd.quiet = false;
 	}
 	else Con_Printf( S_ERROR "Bad rcon_password.\n" );
 }
