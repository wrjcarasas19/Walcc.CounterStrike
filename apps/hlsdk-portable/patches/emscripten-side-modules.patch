diff --git a/cl_dll/CMakeLists.txt b/cl_dll/CMakeLists.txt
index 811c333..f40a37a 100644
--- a/cl_dll/CMakeLists.txt
+++ b/cl_dll/CMakeLists.txt
@@ -197,7 +197,17 @@ if(USE_VOICEMGR)
 	#	../game_shared/voice_status.cpp)
 endif()
 
-add_library (${CLDLL_LIBRARY} SHARED ${CLDLL_SOURCES})
+if(EMSCRIPTEN)
+	# The browser engine loads game libraries as Emscripten side modules.
+	add_executable (${CLDLL_LIBRARY} ${CLDLL_SOURCES})
+	set_target_properties (${CLDLL_LIBRARY} PROPERTIES SUFFIX ".wasm")
+	target_link_options (${CLDLL_LIBRARY} PRIVATE
+		"-sSIDE_MODULE=1"
+		"-Oz"
+		"--minify-wasm-imports")
+else()
+	add_library (${CLDLL_LIBRARY} SHARED ${CLDLL_SOURCES})
+endif()
 target_link_libraries(${CLDLL_LIBRARY} vcs_info)
 
 if (GOLDSOURCE_SUPPORT)
@@ -242,7 +252,7 @@ install(TARGETS ${CLDLL_LIBRARY}
 		GROUP_READ GROUP_EXECUTE
 		WORLD_READ WORLD_EXECUTE)
 
-if(CMAKE_BUILD_TYPE MATCHES "Release" AND NOT WIN32)
+if(CMAKE_BUILD_TYPE MATCHES "Release" AND NOT WIN32 AND NOT EMSCRIPTEN)
 	add_custom_command(TARGET ${CLDLL_LIBRARY}
 			POST_BUILD DEPENDS ${CLDLL_LIBRARY}
 			COMMAND ${CMAKE_STRIP} -s $<TARGET_FILE:${CLDLL_LIBRARY}>)
