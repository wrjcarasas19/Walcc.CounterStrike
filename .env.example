# Copy to .env (ignored by git) and set passwords of your own.

# Password for the F4 admin menu (at least 8 characters). The browser logs
# in with it and the server runs the commands, so the rcon password never
# reaches the browser. 5 wrong tries from one address lock it out for 5
# minutes. Leave empty to have the menu use rcon (RCON_PASSWORD) instead.
ADMIN_PASSWORD=

# Optional rcon password. Letters, digits and _.~!@#%^*=+,:?- only, up to 64
# characters, starting with a letter or digit. With ADMIN_PASSWORD set,
# players can't use rcon and this isn't needed (the server makes up its
# own); without either, the F4 admin menu is disabled.
RCON_PASSWORD=

# Players (humans plus bots) the server keeps in the game, 0 to 32. With 6,
# one player joining finds 5 bots. 0 or unset: no bots until an admin adds
# them from the F4 menu.
BOT_QUOTA=0

# 1 lists bots on the leaderboard (/leaderboard) too. 0 or unset: bots get no
# row (a player's kills on bots and deaths by bots still count).
LEADERBOARD_BOTS=0
