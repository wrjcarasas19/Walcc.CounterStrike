+	write(fd, line, n);
+	// Frame-pointer walk, then the unwinder: one of them may survive -O2.
+	for (int i = 0; i < 32 && ebp > 0x1000 && (ebp & 3) == 0; i++) {
+		unsigned long *f = (unsigned long *)ebp;
+		n = snprintf(line, sizeof line, "fp %08lx\n", f[1]);
+		write(fd, line, n);
+		if (f[0] <= ebp) break;
+		ebp = f[0];
+	}
+	n = backtrace(buf, 64);
+	write(fd, "unwind:\n", 8);
+	backtrace_symbols_fd(buf, n, fd);
