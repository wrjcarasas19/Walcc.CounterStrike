+static void bt_handler(int sig, siginfo_t *si, void *ctx) {
+	ucontext_t *uc = ctx;
+	char line[160];
+	void *buf[64];
+	int fd = open("/tmp/bt.log", O_WRONLY | O_CREAT | O_APPEND, 0644);
+	if (fd < 0) return;
+	unsigned long eip = uc->uc_mcontext.gregs[REG_EIP];
+	unsigned long ebp = uc->uc_mcontext.gregs[REG_EBP];
+	unsigned long esp = uc->uc_mcontext.gregs[REG_ESP];
