+}
+
+static void bt_install(void) {
+	struct sigaction sa;
+	memset(&sa, 0, sizeof sa);
+	sa.sa_sigaction = bt_handler;
+	sa.sa_flags = SA_SIGINFO | SA_ONSTACK | SA_RESTART;
+	sigaction(SIGUSR2, &sa, NULL);
+}
+
+static void bt_signal(int tid) {
+	syscall(SYS_tgkill, getpid(), tid, SIGUSR2);
+}
+*/
+import "C"
+
+import (
+	"os"
+	"sync/atomic"
+	"syscall"
+	"time"
+)
+
+var btTid atomic.Int32
+
+func init() {
+	C.bt_install()
+}
+
+// btNoteThread runs on the engine thread.
+func btNoteThread() {
+	if btTid.Load() == 0 {
+		btTid.Store(int32(syscall.Gettid()))
+	}
+}
+
+func btSample() {
+	tid := btTid.Load()
+	if tid == 0 {
+		return
+	}
+	if maps, err := os.ReadFile("/proc/self/maps"); err == nil {
+		_ = os.WriteFile("/tmp/maps.txt", maps, 0o644)
+	}
+	_ = os.Remove("/tmp/bt.log")
+	for i := 0; i < 6; i++ {
+		C.bt_signal(C.int(tid))
+		time.Sleep(700 * time.Millisecond)
+	}
+}
