diff --git a/apps/server/trace_tmp.go b/apps/server/trace_tmp.go
new file mode 100644
index 0000000..c3277a1
--- /dev/null
+++ b/apps/server/trace_tmp.go
@@ -0,0 +1,96 @@
+package main
+
+// Temporary freeze-investigation trace; not for commit. Keeps the last
+// packets in memory and dumps them once the engine stops calling recvfrom.
+import (
+	"encoding/hex"
+	"fmt"
+	"os"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	goxash3d_fwgs "github.com/yohimik/goxash3d-fwgs/pkg"
+)
+
+type traceEntry struct {
+	at   time.Time
+	dir  byte
+	ip   [4]byte
+	data []byte
+}
+
+const traceSize = 4096
+
+var (
+	traceLock  sync.Mutex
+	traceRing  [traceSize]traceEntry
+	traceNext  int
+	traceCalls atomic.Int64
+	traceLast  atomic.Int64
+)
+
+func init() {
+	go func() {
+		dumped := false
+		still := 0
+		var lastCalls int64
+		for range time.Tick(time.Second) {
+			calls := traceCalls.Load()
+			if calls == 0 {
+				continue
+			}
+			if calls != lastCalls {
+				lastCalls = calls
+				dumped = false
+				still = 0
+				continue
+			}
+			if still++; dumped || still < 3 {
+				continue
+			}
+			dumped = true
+			traceDump()
+			go btSample()
+		}
+	}()
+}
+
+func traceDump() {
+	f, err := os.Create("/tmp/pkt.log")
+	if err != nil {
+		return
+	}
+	defer f.Close()
+	traceLock.Lock()
+	defer traceLock.Unlock()
+	fmt.Fprintf(f, "engine stopped calling recvfrom/sendto after %d calls; last call %s\n",
+		traceCalls.Load(), time.Unix(0, traceLast.Load()).Format("15:04:05.000000"))
+	for i := 0; i < traceSize; i++ {
+		e := traceRing[(traceNext+i)%traceSize]
+		if e.at.IsZero() {
+			continue
+		}
+		d := e.data
+		n := len(d)
+		if n > 256 {
+			d = d[:256]
+		}
+		fmt.Fprintf(f, "%s %c %v %d %s\n", e.at.Format("15:04:05.000000"), e.dir, e.ip, n, hex.EncodeToString(d))
+	}
+}
+
+// tracePacket runs on the engine thread only.
+func tracePacket(dir byte, p *goxash3d_fwgs.Packet) {
+	now := time.Now()
+	btNoteThread()
+	traceCalls.Add(1)
+	traceLast.Store(now.UnixNano())
+	if p == nil {
+		return
+	}
+	traceLock.Lock()
+	traceRing[traceNext] = traceEntry{now, dir, p.IP, append([]byte(nil), p.Data...)}
+	traceNext = (traceNext + 1) % traceSize
+	traceLock.Unlock()
+}
